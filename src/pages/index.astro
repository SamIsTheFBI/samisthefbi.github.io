---
import Base from "@/layouts/Base.astro";
import ProjectItem from "@/components/home/ProjectItem.astro";
import { LuArrowUpRight, LuCopy, LuCheck, LuGithub } from "react-icons/lu";
import { RiTwitterXFill } from "react-icons/ri";

const title = "Home | SamIsTheFBI";
---

<Base title={title} description="Fancy home page">
    <section class="sm:mt-5">
        <a
            href="/about"
            class="text-5xl md:text-6xl font-serif animate-hero"
            transition:name="my_name"
        >
            Shivam Shekhar Soy
        </a>
        <p class="max-md:text-sm text-muted-foreground animate-entrance stagger-1">
            software developer
        </p>
    </section>
    <section class="space-y-6 pt-3">
        <p class="text-sm text-pretty animate-entrance stagger-3">
            Hey I'm Shivam, I go by <i>SamIsTheFBI</i> online. I'm into webdev,
            systems & lately, I've been fooling around with AI agents. Aside
            from that, I do a little bit of sketching, watching movies, and
            playing video games.
        </p>
    </section>
    <section class="mt-8 space-y-4">
        <div class="animate-entrance stagger-4 flex items-center gap-4">
            <h3
                id="experience"
                class="font-semibold text-lg sm:text-xl text-muted-foreground shrink-0"
            >
                <a href="#experience">Work Experience</a>
            </h3>
            <hr class="border-border w-full" />
        </div>
        <ul class="space-y-5">
            <div class="animate-entrance stagger-5">
                <ProjectItem
                    name="Inkle"
                    href="https://inkle.ai/"
                    description="engg"
                    meta="2026"
                />
            </div>
            <div class="animate-entrance stagger-6">
                <ProjectItem
                    name="GNU Image Manipulation Program"
                    href="https://summerofcode.withgoogle.com/programs/2025/projects/4I53AOAO"
                    description="gsoc'25 mentee"
                    meta="2025"
                />
            </div>
            <div class="animate-entrance stagger-7">
                <ProjectItem
                    name="Kickoff Labs"
                    href="https://letskickoff.com/"
                    description="fullstack dev"
                    meta="2024-25"
                />
            </div>
        </ul>
    </section>
    <section class="mt-8 space-y-4">
        <div
            class="animate-entrance flex items-center gap-4"
            style="animation-delay: 350ms"
        >
            <h3
                id="projects"
                class="font-semibold text-lg sm:text-xl text-muted-foreground shrink-0"
            >
                <a href="#projects">Projects</a>
            </h3>
            <hr class="border-border w-full" />
        </div>

        <ul class="space-y-5">
            <div class="animate-entrance" style="animation-delay: 390ms">
                <ProjectItem
                    name="Mnemosyne"
                    href="https://github.com/SamIsTheFBI/semantic-image-search"
                    description="Search images by meaning, not filename"
                />
            </div>
            <div class="animate-entrance" style="animation-delay: 430ms">
                <ProjectItem
                    name="Ciphera"
                    href="https://github.com/SamIsTheFBI/Lets-Chat"
                    description="Matrix client app with org registration backend"
                    award="1st Runner-Up @ Ethos 2024"
                />
            </div>
            <div class="animate-entrance" style="animation-delay: 470ms">
                <ProjectItem
                    name="MUNSOC NIT Agartala"
                    href="https://munsoc.in/"
                    description="Official club website with blog CMS and event pages"
                />
            </div>
            <div class="animate-entrance" style="animation-delay: 510ms">
                <ProjectItem
                    name="Stellar Minesite"
                    href="https://stellar-minesite.vercel.app/"
                    description="ML-driven mining site analysis webapp"
                    award="1st @ ISRO Space Hackathon"
                />
            </div>
            <div class="animate-entrance" style="animation-delay: 550ms">
                <ProjectItem
                    name="Watchmenu"
                    href="https://github.com/SamIsTheFBI/watchmenu"
                    description="Organize and watch movies & TV shows via Bash"
                />
            </div>
        </ul>
    </section>
    <section class="mt-8 space-y-4">
        <div
            class="animate-entrance flex items-center gap-4"
            style="animation-delay: 590ms"
        >
            <h3
                id="hire-me"
                class="font-semibold text-lg sm:text-xl text-muted-foreground shrink-0"
            >
                <a href="#hire-me">Hire me</a>
            </h3>
            <hr class="border-border w-full" />
        </div>

        <p class="text-sm animate-entrance" style="animation-delay: 630ms">
            If you're looking to connect for a project, feel free to reach out
            via
            <button
                id="copy-email"
                class="inline-flex items-center gap-0.5 cursor-pointer font-bold group/email"
            >
                <span>email</span>
                <span class="relative w-[13px] h-[13px]">
                    <LuCopy
                        className="absolute inset-0 transition-[opacity,transform] duration-200 ease-out"
                        size={13}
                        id="icon-copy"
                    />
                    <LuCheck
                        className="absolute inset-0 opacity-0 scale-75 transition-[opacity,transform] duration-200 ease-out"
                        size={13}
                        id="icon-check"
                    />
                </span>
            </button>
            . You can also find me on
            <a
                href="https://github.com/samisthefbi"
                target="_blank"
                class="inline-flex items-center gap-0.5 font-bold group/gh cursor-pointer underline"
            >
                Github
                <span class="relative w-[13px] h-[13px]">
                    <LuGithub
                        className="absolute inset-0 transition-opacity duration-200 ease-out group-hover/gh:opacity-0"
                        size={13}
                    />
                    <LuArrowUpRight
                        className="absolute inset-0 opacity-0 group-hover/gh:opacity-100 transition-opacity duration-200 ease-out"
                        size={13}
                    />
                </span>
            </a>
            and
            <a
                href="https://x.com/samisthefbi"
                target="_blank"
                class="inline-flex items-center gap-0.5 font-bold group/x cursor-pointer underline"
            >
                Twitter
                <span class="relative w-[13px] h-[13px]">
                    <RiTwitterXFill
                        className="absolute inset-0 transition-opacity duration-200 ease-out group-hover/x:opacity-0"
                        size={13}
                    />
                    <LuArrowUpRight
                        className="absolute inset-0 opacity-0 group-hover/x:opacity-100 transition-opacity duration-200 ease-out"
                        size={13}
                    />
                </span>
            </a>
            if you find my work interesting.
        </p>
    </section>

    <script>
        const btn = document.getElementById("copy-email");
        const iconCopy = document.getElementById("icon-copy");
        const iconCheck = document.getElementById("icon-check");

        btn?.addEventListener("click", async () => {
            await navigator.clipboard.writeText("shivamshekharsoy@gmail.com");
            if (iconCopy && iconCheck) {
                iconCopy.style.opacity = "0";
                iconCopy.style.transform = "scale(0.75)";
                iconCheck.style.opacity = "1";
                iconCheck.style.transform = "scale(1)";
                setTimeout(() => {
                    iconCopy.style.opacity = "1";
                    iconCopy.style.transform = "scale(1)";
                    iconCheck.style.opacity = "0";
                    iconCheck.style.transform = "scale(0.75)";
                }, 1500);
            }
        });
    </script>
</Base>
