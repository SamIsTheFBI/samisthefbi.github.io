---
import Links from "@/components/home/Links.astro";
---

<footer class="overflow-hidden h-24 sticky top-0 z-50 w-full text-sm">
    <div class="max-w-2xl w-full mx-auto px-4 flex h-20 items-center justify-between">
        <div class="">
            <a
                href="/"
                class="inline-block font-bold tracking-tighter text-muted-foreground"
            >
                Shivam.
            </a>
            <br />
            <span id="steam-presence" class="text-xs"></span>
        </div>
        <div class="flex gap-2 text-lg">
            <Links />
        </div>
    </div>
</footer>
<script>
    function fetchSteamPresence() {
        fetch("https://steam-stats-silk.vercel.app/api/steam/presence")
            .then((res) => res.json())
            .then((data) => {
                const steamElem = document.getElementById("steam-presence");
                if (!(steamElem instanceof HTMLSpanElement)) return;

                if (data.activity) {
                    steamElem.textContent =
                        "Playing " + data.activity.name + " on Steam rn.";
                } else if (data.status === "Online") {
                    steamElem.textContent = "Active on Steam rn.";
                } else {
                    steamElem.textContent = "";
                }
            })
            .catch((err) => {
                console.error("Failed to fetch steam presence:", err);
            });
    }

    document.addEventListener("astro:page-load", fetchSteamPresence);
</script>
